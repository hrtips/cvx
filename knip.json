{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/*.js",
    "test/**/*.{test.js,js}",
    "src/standalone/entry.js"
  ],
  "project": [
    "src/**/*.{js,jsx}",
    "bin/**/*.js",
    "scripts/**/*.js"
  ],
  "ignoreBinaries": [
    "pdftoppm",
    "pdftotext",
    "pdfinfo"
  ],
  "ignoreDependencies": [
    "cvx"
  ]
}
