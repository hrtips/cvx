{
  "name": "makecv",
  "version": "1.1.0",
  "description": "Config-driven CV generator: YAML content, swappable themes and layouts, pixel-perfect PDFs — no headless browser.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "node scripts/build-lib.js",
    "prepack": "npm run build:lib",
    "preview": "vite preview",
    "pdf": "npx tsx scripts/export-pdf.js",
    "pdf:ats": "npx tsx scripts/export-pdf-ats.js",
    "test": "vitest run"
  },
  "type": "module",
  "bin": {
    "makecv": "bin/makecv.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "lib",
    "bin",
    "template"
  ],
  "devDependencies": {
    "@rollup/plugin-yaml": "^5.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "js-yaml": "^4.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
